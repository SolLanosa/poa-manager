package com.poa_manager;

import com.poa_manager.entities.AuthorizationRequest;
import com.poa_manager.entities.Decision;
import com.poa_manager.entities.PowerOfAttorney;
import com.poa_manager.entities.PowerOfAttorneyFaculty;
import com.poa_manager.entities.PowerOfAttorneySigningRule;

dialect "java"

declare Approval
  poaId: Long
  facultyId: Long
  ruleId: Long
  signingRule: PowerOfAttorneySigningRule
end


rule "grant"
salience 100
when
  $req: AuthorizationRequest()
  $poa: PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true)
  $fac: PowerOfAttorneyFaculty(powerOfAttorney.id == $poa.id, covers($req.getAction(), $req.getObject()) == true, coversItem($req.getItemRef()) == true)
  $sr: PowerOfAttorneySigningRule(powerOfAttorneyFaculty.id == $fac.id, amountFulfills($req.getAmount(), $req.getCurrency()) == true, isSignedBy($req.getSigners()) == true)
then
  insert(new Approval($poa.getId(), $fac.getId(), $sr.getId(), $sr));
end


rule "APPROVED"
salience 50
when
  $d: Decision()
  $a: Approval($ruleId: ruleId)
  not Approval(ruleId > $ruleId)
then
  $d.approve($a.getPoaId(), $a.getFacultyId(), $a.getRuleId());
  $d.addObservation("APPROVED", "Signed under power of attorney " + $a.getPoaId() + ", signing rule " + $a.getRuleId() + " requiring " + $a.getSigningRule().toString());
end


rule "DENIED: no power of attorney in force"
when
  $req: AuthorizationRequest()
  $d: Decision()
  not PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true)
then
  $d.addObservation("NO_POA_IN_FORCE", "No power of attorney is in force on " + $req.getDate());
end


rule "DENIED: no faculty"
when
  $req: AuthorizationRequest()
  $d: Decision()
  exists PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true)
  not ($p: PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true) and PowerOfAttorneyFaculty(powerOfAttorney.id == $p.id, covers($req.getAction(), $req.getObject()) == true))
then
  $d.addObservation("NO_FACULTY", "No power of attorney in force grants " + $req.getAction() + " on " + $req.getObject());
end


rule "DENIED: item out of scope"
when
  $req: AuthorizationRequest()
  $d: Decision()
  exists ($p1: PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true) and PowerOfAttorneyFaculty(powerOfAttorney.id == $p1.id, covers($req.getAction(), $req.getObject()) == true ))
  not ($p2: PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true) and PowerOfAttorneyFaculty(powerOfAttorney.id == $p2.id, covers($req.getAction(), $req.getObject()) == true, coversItem($req.getItemRef()) == true ))
then
  $d.addObservation("OUT_OF_SCOPE", "The faculty is granted but is limited to items that do not include " + $req.getItemRef());
end


rule "DENIED: amount out of band"
when
  $req: AuthorizationRequest()
  $d: Decision()
  exists ($p1: PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true) and PowerOfAttorneyFaculty(powerOfAttorney.id == $p1.id, covers($req.getAction(), $req.getObject()) == true, coversItem($req.getItemRef()) == true))
  not ($p2: PowerOfAttorney( company.id == $req.getCompany().getId(), isActive($req.getDate()) == true) and $f2 : PowerOfAttorneyFaculty(powerOfAttorney.id == $p2.id, covers($req.getAction(), $req.getObject()) == true, coversItem($req.getItemRef()) == true) and PowerOfAttorneySigningRule(powerOfAttorneyFaculty.id == $f2.id, amountFulfills($req.getAmount(), $req.getCurrency()) == true ))
then
  $d.addObservation("AMOUNT_OUT_OF_BAND", "The faculty is granted but no signing rule covers " + $req.getAmount() + " " + $req.getCurrency());
end


rule "DENIED: insufficient signatures"
when
  $req: AuthorizationRequest()
  $d: Decision()
  $poa: PowerOfAttorney(company.id == $req.getCompany().getId(), isActive($req.getDate()) == true)
  $fac: PowerOfAttorneyFaculty(powerOfAttorney.id == $poa.id, covers($req.getAction(), $req.getObject()) == true, coversItem($req.getItemRef()) == true)
  exists PowerOfAttorneySigningRule(powerOfAttorneyFaculty.id == $fac.id, amountFulfills($req.getAmount(), $req.getCurrency()) == true)
  not Approval()
then
  $d.addObservation("INSUFFICIENT_SIGNATURES", "A signing rule for action: " + $req.getAction() + ", object: " + $req.getObject() + " " + ($req.getItemRef() == null ? "" : $req.getItemRef()) + ", amount: " + $req.getAmount() + " exists but the signers do not meet any signing rule of the granted faculty.\n" + "Required signatures: \n" + $fac.printSigningRules($req.getAmount(), $req.getCurrency()));
end
